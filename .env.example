# Copy to .env and fill in. .env is gitignored.

# ── Required ──────────────────────────────────────────────────────────────────
# Free, no credit card: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-key-here

# ── Backend selection ─────────────────────────────────────────────────────────
# auto   probe AWS, fall back to local if anything fails   (default)
# local  skip the probe entirely — no boto3 import, no network call
# aws    demand AWS; refuse to start if the probe fails
AGENTIC_SCRUM_BACKEND=auto

# ── AWS (only needed when running against a deployed stack) ────────────────────
# These come from the LocalEnv output of infra/deploy.sh. Leave them unset and
# the probe falls back to local.
# AWS_REGION=us-east-1
# SCRUM_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:agentic-scrum-events
# SCRUM_BUCKET=agentic-scrum-artifacts-123456789012-us-east-1
# SCRUM_STATE_TABLE=agentic-scrum-runs
# SCRUM_QUEUE_PREFIX=https://sqs.us-east-1.amazonaws.com/123456789012

# ── Tuning ────────────────────────────────────────────────────────────────────
# SCRUM_MODEL=gemini-2.5-flash
# SCRUM_MAX_ATTEMPTS=3        # Dev/QA cycles before escalating to a human
# SCRUM_MAX_REACT_STEPS=8     # tool calls per agent turn
# SCRUM_TOOL_TIMEOUT=15       # seconds before run_python kills the subprocess
